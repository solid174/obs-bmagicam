#!/usr/bin/env bash
# Starts OBS, waits until its startup is complete and the Beautify filter in the test scene collection
# (load-test-scenes.json) has loaded its face models, stops it, and checks in its log that obs-bmagicam loaded,
# that the filter compiled its effect and that it found and loaded its face models.
#
# Usage: load-test <log directory> <OBS process name> <command that starts OBS...>

set -euo pipefail

log_dir=$1
process_name=$2
shift 2

# Only a log written by this start counts, also when an earlier start left one
previous=$(ls -t "${log_dir}"/*.txt 2> /dev/null | head -n 1 || true)

"$@" > "${RUNNER_TEMP:-/tmp}/obs-output.txt" 2>&1 &
obs_pid=$!

log=''
for _ in $(seq 1 120); do
  log=$(ls -t "${log_dir}"/*.txt 2> /dev/null | head -n 1 || true)
  if [[ ${log} == "${previous}" ]]; then
    log=''
  elif [[ -n ${log} ]] && grep -q '==== Startup complete' "${log}" &&
    grep -qE '\[obs-bmagicam\] Beautify (loaded|cannot load) its face models' "${log}"; then
    break
  fi
  if ! kill -0 "${obs_pid}" 2> /dev/null; then
    break
  fi
  sleep 1
done

pkill -x "${process_name}" || true
wait "${obs_pid}" 2> /dev/null || true

if [[ -z ${log} ]]; then
  echo '::error::OBS wrote no log. Its output:'
  cat "${RUNNER_TEMP:-/tmp}/obs-output.txt"
  exit 1
fi

cat "${log}"

if ! grep -q '\[obs-bmagicam\] plugin loaded successfully' "${log}"; then
  echo '::error::obs-bmagicam did not load in OBS'
  exit 1
fi

if grep -E '\[obs-bmagicam\] (this build is for|cannot receive SRT)' "${log}"; then
  echo '::error::the FFmpeg in OBS cannot run the stream receiver'
  exit 1
fi

if ! grep -q "filter: 'Beautify' (bmagicam_beautify)" "${log}"; then
  echo '::error::the test scene collection did not load the Beautify filter'
  exit 1
fi

if grep -q '\[obs-bmagicam\] Beautify cannot load its effect' "${log}"; then
  echo '::error::the Beautify effect does not compile with this renderer'
  exit 1
fi

if ! grep -q '\[obs-bmagicam\] Beautify loaded its face models' "${log}"; then
  echo '::error::the Beautify filter did not load its face models'
  exit 1
fi
